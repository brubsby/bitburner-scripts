{
  "name": "bitburner-scripts",
  "version": "1.0.0",
  "description": "",
  "main": "bashrc.js",
  "scripts": {
    "daemon": "node tools/rfa-daemon.mjs",
    "gosolver": "nice -n 19 node tools/go-solver.mjs --maxms 800 --poll 150",
    "verify": "node tools/verify-deploy.mjs",
    "verify:home": "node tools/verify-deploy.mjs --home-only",
    "verify:json": "node tools/verify-deploy.mjs --json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brubsby/bitburner-scripts.git"
  },
  "keywords": [],
